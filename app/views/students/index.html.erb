<div class="dashboard">
  <div class="dashboard-header">
    <div>
      <p class="eyebrow">Tableau de bord</p>
      <h1>Mes élèves</h1>
    </div>
  </div>
<section class="exercise-types">
  <%= link_to reading_texts_path, class: "exercise-card exercise-card--active" do %>
  <i class="ti ti-book-2"></i>
  <p class="exercise-title">Fluence de lecture</p>
  <p class="exercise-desc">Gérer les textes</p>
<% end %>
    <%= link_to mot_outils_path, class: "exercise-card exercise-card--active" do %>
  <i class="ti ti-tools"></i>
  <p class="exercise-title">Mots outils</p>
  <p class="exercise-desc">Gérer la liste des mots</p>
<% end %>
    <div class="exercise-card exercise-card--soon">
      <i class="ti ti-abc"></i>
      <p class="exercise-title">Mots inexistants</p>
      <p class="exercise-desc">Bientôt disponible</p>
    </div>
  </section>

  <section class="roster">
    <p class="eyebrow">Élèves</p>
    <ul class="roster-list">
      <% @students.each do |student| %>
        <% last_session = student.sessions.max_by(&:created_at) %>
        <li class="roster-row">
          <div class="roster-identity">
            <div class="avatar"><%= student.first_name[0] %><%= student.last_name[0] %></div>
            <div>
              <p class="roster-name"><%= student.name %></p>
              <p class="roster-last-session">
                <% if last_session.nil? %>
                  Aucune séance
                <% elsif last_session.aborted %>
                  Dernière séance : abandon
                <% elsif last_session.mclm_score.present? %>
                  Dernière séance : <%= last_session.mclm_score %> MCLM
                <% else %>
                  Dernière séance : pas de score
                <% end %>
              </p>
            </div>
          </div>
          <%= link_to student_path(student), class: "btn-handoff" do %>
            <i class="ti ti-player-play"></i> Donner la main
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>

  <hr class="divider">
  <p><%= link_to "Se connecter avec un code", login_path %></p>
</div>