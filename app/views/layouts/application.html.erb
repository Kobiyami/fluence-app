<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Fluence App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Fluence App">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <meta name="turbo-cache-control" content="no-cache">
    
  </head>

  <body>
    <nav class="navbar navbar-fluence mb-4">
      <div class="container">
        <span class="navbar-brand">📚 FluenceApp</span>
        <% if session[:student_id] %>
          <span class="text-white">
            👤 <%= Student.find(session[:student_id]).first_name rescue nil %>
          </span>
        <% end %>
      </div>
    </nav>

    <main class="container">
      <%= yield %>
    </main>
  </body>
</html>