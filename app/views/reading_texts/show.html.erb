<div class="dashboard">
  <p><%= link_to "← Textes de lecture", reading_texts_path, class: "back-link" %></p>

  <p class="eyebrow">Modifier le texte</p>

  <% if @reading_text.errors.any? %>
    <p class="login-error"><%= @reading_text.errors.full_messages.to_sentence %></p>
  <% end %>

  <%= form_with model: @reading_text, url: reading_text_path(@reading_text), method: :patch, class: "text-form" do |f| %>
    <%= f.text_field :title, class: "login-input" %>
    <%= f.text_area :content, class: "login-input text-area", rows: 8 %>
    <p class="roster-last-session"><%= @reading_text.word_count %> mots</p>
    <%= f.submit "Enregistrer", class: "btn-reading btn-reading--start" %>
  <% end %>

  <%= button_to "Supprimer ce texte", reading_text_path(@reading_text), method: :delete,
        data: { turbo_confirm: "Supprimer « #{@reading_text.title} » ?" },
        class: "btn-delete" %>
</div>