<div class="dashboard">
  <p><%= link_to "← Tableau de bord", students_path, class: "back-link" %></p>

  <p class="eyebrow">Suivi</p>
  <h1>Progression des élèves</h1>

  <% if notice %>
    <p class="login-error login-error--success"><%= notice %></p>
  <% end %>

  <% @students.each do |student| %>
    <details class="student-accordion">
      <summary class="student-summary">
        <div class="avatar"><%= student.first_name[0] %><%= student.last_name[0] %></div>
        <span class="roster-name"><%= student.name %></span>
      </summary>

      <div class="student-accordion-body">
        <div class="stats-tabs" data-controller="stats-tabs" data-stats-tabs-storage-key-value="stats_tab_<%= student.id %>" data-stats-tabs-default-value="fluence">
          <div class="tab-buttons">
            <button type="button" class="tab-button" data-tab="fluence" data-stats-tabs-target="button" data-action="click->stats-tabs#switch">
              <i class="ti ti-book-2"></i> Fluence de lecture
            </button>
            <button type="button" class="tab-button" data-tab="mots_outils" data-stats-tabs-target="button" data-action="click->stats-tabs#switch">
              <i class="ti ti-tools"></i> Mots outils
            </button>
          </div>

          <div class="tab-panel" data-tab-panel="fluence" data-stats-tabs-target="panel">
            <% first_chart = first_attempts_chart(student) %>
            <% if first_chart %>
              <details class="chart-accordion">
                <summary class="chart-summary"><i class="ti ti-chart-line"></i> Progression sur les premières lectures</summary>
                <div class="chart-wrapper">
                  <%= first_chart %>
                  <p class="chart-legend">
                    <span class="legend-dot legend-dot--mclm"></span> MCLM
                    <span class="legend-dot legend-dot--pct"></span> % lu
                  </p>
                </div>
              </details>
            <% end %>

            <% summary = fluence_summary(student) %>
            <% if summary.any? %>
              <% summary.each do |item| %>
                <details class="text-accordion">
                  <summary class="text-summary">
                    <span class="text-title">
                      <%= item[:text].title %>
                      <span class="text-record">
                        <i class="ti ti-trophy"></i>
                        <%= item[:record] %> mots · <%= item[:record_completion] %>%
                      </span>
                    </span>
                    <span class="text-meta">
                      <span class="text-meta-label">Dernière lecture</span>
                      <%= item[:latest].created_at.strftime("%d/%m") %> ·
                      <%= item[:latest].mclm_score %> MCLM ·
                      <%= item[:latest].completion_rate %>%
                    </span>
                    <span class="trend trend--<%= item[:trend] %>">
                      <% if item[:trend] == :progress %>
                        <i class="ti ti-trending-up"></i>
                      <% elsif item[:trend] == :stagnant %>
                        <i class="ti ti-minus"></i>
                      <% else %>
                        <i class="ti ti-trending-down"></i>
                      <% end %>
                    </span>
                  </summary>

                  <table class="stats-table">
                    <thead>
                      <tr><th>#</th><th>Date</th><th>MCLM</th><th>% lu</th><th></th></tr>
                    </thead>
                    <tbody>
                      <% item[:attempts].each do |a| %>
                        <tr>
                          <td><%= a[:number] %></td>
                          <td><%= a[:session].created_at.strftime("%d/%m %H:%M") %></td>
                          <td><%= a[:session].mclm_score %></td>
                          <td><%= a[:session].completion_rate %>%</td>
                          <td>
                            <%= button_to "🗑", session_path(a[:session]), method: :delete,
                                  data: { turbo_confirm: "Supprimer cette séance ?" },
                                  class: "btn-delete-icon" %>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>

                  <% if item[:attempts_chrono].size >= 2 %>
                    <details class="chart-accordion">
                      <summary class="chart-summary"><i class="ti ti-chart-line"></i> Graphique</summary>
                      <div class="chart-wrapper">
                        <%= attempts_chart_svg(item[:attempts_chrono]) %>
                        <p class="chart-legend">
                          <span class="legend-dot legend-dot--mclm"></span> MCLM
                          <span class="legend-dot legend-dot--pct"></span> % lu
                        </p>
                      </div>
                    </details>
                  <% end %>
                </details>
              <% end %>
            <% else %>
              <p class="roster-last-session">Aucune séance de lecture.</p>
            <% end %>
          </div>

          <div class="tab-panel" data-tab-panel="mots_outils" data-stats-tabs-target="panel" style="display:none">
  <% nouveaux = student.mots_nouveaux %>
  <% difficiles = student.mots_difficiles %>
  <% consolider = student.mots_a_consolider %>
  <% maitrises = student.mots_maitrises %>

  <div class="stats-tabs" data-controller="stats-tabs" data-stats-tabs-storage-key-value="stats_category_<%= student.id %>" data-stats-tabs-default-value="difficiles">
    <div class="tab-buttons tab-buttons--mini">
      <button type="button" class="tab-button tab-button--mini" data-tab="nouveaux" data-stats-tabs-target="button" data-action="click->stats-tabs#switch">
        Nouveautés (<%= nouveaux.count %>)
      </button>
      <button type="button" class="tab-button tab-button--mini" data-tab="difficiles" data-stats-tabs-target="button" data-action="click->stats-tabs#switch">
        À travailler (<%= difficiles.count %>)
      </button>
      <button type="button" class="tab-button tab-button--mini" data-tab="consolider" data-stats-tabs-target="button" data-action="click->stats-tabs#switch">
        Ok (<%= consolider.count %>)
      </button>
      <button type="button" class="tab-button tab-button--mini" data-tab="maitrises" data-stats-tabs-target="button" data-action="click->stats-tabs#switch">
        Top (<%= maitrises.count %>)
      </button>
    </div>

    <div class="tab-panel" data-tab-panel="nouveaux" data-stats-tabs-target="panel">
      <% if nouveaux.any? %>
        <ul class="word-simple-list">
          <% nouveaux.each { |mot| %><li><%= mot.text %></li><% } %>
        </ul>
      <% else %>
        <p class="roster-last-session">Aucun mot dans cette catégorie.</p>
      <% end %>
    </div>

    <div class="tab-panel" data-tab-panel="difficiles" data-stats-tabs-target="panel" style="display:none">
      <% if difficiles.any? %>
        <ul class="word-simple-list">
          <% difficiles.each { |t| %>
            <li>
              <%= t.mot_outil.text %>
              <% unless t.ever_succeeded? %><span class="tier-badge tier-badge--never">Jamais réussi</span><% end %>
            </li>
          <% } %>
        </ul>
      <% else %>
        <p class="roster-last-session">Aucun mot dans cette catégorie.</p>
      <% end %>
    </div>

    <div class="tab-panel" data-tab-panel="consolider" data-stats-tabs-target="panel" style="display:none">
      <% if consolider.any? %>
        <ul class="word-simple-list">
          <% consolider.each { |t| %><li><%= t.mot_outil.text %></li><% } %>
        </ul>
      <% else %>
        <p class="roster-last-session">Aucun mot dans cette catégorie.</p>
      <% end %>
    </div>

    <div class="tab-panel" data-tab-panel="maitrises" data-stats-tabs-target="panel" style="display:none">
      <% if maitrises.any? %>
        <ul class="word-simple-list">
          <% maitrises.each { |t| %><li><%= t.mot_outil.text %></li><% } %>
        </ul>
      <% else %>
        <p class="roster-last-session">Aucun mot dans cette catégorie.</p>
      <% end %>
    </div>
  </div>
</div>
        </div>
      </div>
    </details>
  <% end %>
</div>