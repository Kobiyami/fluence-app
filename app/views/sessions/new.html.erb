<div class="reading-screen">
  <p><%= link_to "← Changer d'élève", students_path, class: "back-link" %></p>

  <p class="eyebrow">Prêt à lire</p>

  <div class="ready-card">
    <div class="ready-icon"><i class="ti ti-book-2"></i></div>
    <h1><%= @reading_text.title %></h1>
    <p class="ready-student">Pour <strong><%= @student.first_name %></strong></p>

    <%= button_to "Démarrer",
                "/sessions/start",
                method: :post,
                params: {
                  student_id: @student.id,
                  reading_text_id: @reading_text.id
                },
                data: { turbo: false },
                class: "btn-reading btn-reading--start btn-reading--wide" %>

    <p class="handoff-hint">
      <i class="ti ti-device-tablet"></i>
      Donne la tablette à <%= @student.first_name %> avant de cliquer sur Démarrer
    </p>

    <%= link_to "← Choisir un autre texte", student_path(@student), class: "back-link back-link--spaced" %>
  </div>
</div>